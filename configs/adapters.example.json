{
  "version": "1.0.0",
  "active_profiles": {
    "worker": "gemini_worker",
    "reviewer": "muse_reviewer",
    "fallback_worker": "deepseek_worker",
    "fallback_reviewer": "deepseek_reviewer"
  },
  "adapters": {
    "gemini_worker": {
      "role": "worker",
      "provider": "google_via_local_proxy",
      "api_protocol": "anthropic_messages",
      "model_id": "gemini-3.8-flash-high",
      "endpoint_url": "http://localhost:8787/v1",
      "api_key_env": "GEMINI_API_KEY",
      "context_window_tokens": 1000000,
      "max_output_tokens": 64000,
      "temperature": 0.2,
      "timeout_seconds": 300,
      "capacity_source": "user_provided_not_load_tested",
      "capabilities": {
        "structured_outputs": "prompt_json_local_validation",
        "function_calling": false,
        "vision": false
      }
    },
    "muse_reviewer": {
      "role": "reviewer",
      "provider": "custom_muse",
      "api_protocol": "responses",
      "model_id": "muse-spark-1.3-contributor-free",
      "endpoint_url": "http://127.0.0.1:8787/v1",
      "api_key_env": "MUSE_API_KEY",
      "context_window_tokens": 1000000,
      "max_output_tokens": 131072,
      "reasoning_effort": "max",
      "timeout_seconds": 300,
      "capacity_source": "user_provided_not_load_tested",
      "capabilities": {
        "structured_outputs": true,
        "native_schema_enforcement": "unverified",
        "function_calling": false,
        "vision": false
      }
    },
    "deepseek_worker": {
      "role": "worker",
      "provider": "openai_compatible",
      "model_id": "deepseek-flash",
      "endpoint_url": "https://api.deepseek.com/v1",
      "api_key_env": "DEEPSEEK_API_KEY",
      "temperature": 0.2,
      "max_tokens": 8192,
      "timeout_seconds": 60,
      "capabilities": {
        "structured_outputs": true,
        "function_calling": true,
        "vision": false
      }
    },
    "deepseek_reviewer": {
      "role": "reviewer",
      "provider": "openai_compatible",
      "model_id": "deepseek-flash",
      "endpoint_url": "https://api.deepseek.com/v1",
      "api_key_env": "DEEPSEEK_API_KEY",
      "temperature": 0.0,
      "max_tokens": 4096,
      "timeout_seconds": 45,
      "capabilities": {
        "structured_outputs": true,
        "function_calling": false,
        "vision": false
      }
    }
  }
}
