{
  "version": "1.0.0",
  "active_profiles": {
    "worker": "gemini_worker",
    "reviewer": "muse_reviewer",
    "fallback_worker": "deepseek_worker",
    "fallback_reviewer": "deepseek_reviewer"
  },
  "adapters": {
    "gemini_worker": {
      "role": "worker",
      "provider": "google",
      "model_id": "gemini-1.5-pro",
      "endpoint_url": "https://generativelanguage.googleapis.com/v1beta",
      "api_key_env": "GEMINI_API_KEY",
      "temperature": 0.2,
      "max_tokens": 8192,
      "timeout_seconds": 60,
      "capabilities": {
        "structured_outputs": true,
        "function_calling": true,
        "vision": true
      }
    },
    "muse_reviewer": {
      "_note": "示例占位配置，未经验证，待架构师提供真实接口参数后替换",
      "role": "reviewer",
      "provider": "custom_muse",
      "model_id": "muse-v1",
      "endpoint_url": "https://api.muse.example.com/v1",
      "api_key_env": "MUSE_API_KEY",
      "temperature": 0.0,
      "max_tokens": 4096,
      "timeout_seconds": 45,
      "capabilities": {
        "structured_outputs": true,
        "function_calling": false,
        "vision": false
      }
    },
    "deepseek_worker": {
      "role": "worker",
      "provider": "openai_compatible",
      "model_id": "deepseek-flash",
      "endpoint_url": "https://api.deepseek.com/v1",
      "api_key_env": "DEEPSEEK_API_KEY",
      "temperature": 0.2,
      "max_tokens": 8192,
      "timeout_seconds": 60,
      "capabilities": {
        "structured_outputs": true,
        "function_calling": true,
        "vision": false
      }
    },
    "deepseek_reviewer": {
      "role": "reviewer",
      "provider": "openai_compatible",
      "model_id": "deepseek-flash",
      "endpoint_url": "https://api.deepseek.com/v1",
      "api_key_env": "DEEPSEEK_API_KEY",
      "temperature": 0.0,
      "max_tokens": 4096,
      "timeout_seconds": 45,
      "capabilities": {
        "structured_outputs": true,
        "function_calling": false,
        "vision": false
      }
    }
  }
}
