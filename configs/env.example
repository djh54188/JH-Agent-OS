# JH-Agent OS 环境配置示例
# 复制为 .env 或配置到系统环境变量中；切勿提交真实密钥至代码仓库！

# OpenAI Codex 凭据（默认通过 ~/.codex/auth.json 读取，无需显式配置）
# CODEX_HOME=C:\Users\a\.codex

# Google Gemini API 凭据（首选 Worker）
GEMINI_API_KEY=your_gemini_api_key_here

# Muse API 凭据与自定义端点（首选 Reviewer）
MUSE_API_KEY=your_muse_api_key_here
MUSE_API_ENDPOINT=http://127.0.0.1:8787/v1

# DeepSeek API 凭据（本地备选/回退通道）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 系统与安全策略配置
JH_WORKSPACE_ROOT=D:\JH-Agent OS
JH_SANDBOX_MODE=workspace-write
JH_LOG_LEVEL=INFO
