{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jh-agent-os.local/schemas/plan.v1.json",
  "title": "PlanSchemaV1",
  "description": "JH-Agent OS Plan entity contract defining structured execution steps and risk mitigation.",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "task_id",
    "goal_summary",
    "steps",
    "fallback_strategy",
    "revision",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "plan_id": {
      "type": "string",
      "pattern": "^plan_[a-zA-Z0-9_-]{8,64}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^task_[a-zA-Z0-9_-]{8,64}$"
    },
    "goal_summary": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "step_id",
          "title",
          "description",
          "role",
          "tool_dependencies",
          "risk_level",
          "expected_outcome",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "step_id": {
            "type": "string",
            "pattern": "^step_[a-zA-Z0-9_-]{2,32}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": ["worker", "reviewer", "meta_planner", "orchestrator"]
          },
          "tool_dependencies": {
            "type": "array",
            "items": { "type": "string" }
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "read_only",
              "workspace_write",
              "system_sensitive",
              "danger_external"
            ]
          },
          "expected_outcome": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "completed", "failed", "skipped"]
          }
        }
      }
    },
    "fallback_strategy": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
