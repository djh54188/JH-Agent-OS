{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jh-agent-os.local/schemas/task.v1.json",
  "title": "TaskSchemaV1",
  "description": "JH-Agent OS Task entity contract defining unit of work lifecycle, acceptance criteria, 3D risk assessment, and metadata.",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "title",
    "description",
    "acceptance_criteria",
    "priority",
    "status",
    "budget",
    "context",
    "risk_assessment",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "task_id": {
      "type": "string",
      "pattern": "^task_[a-zA-Z0-9_-]{8,64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Explicit, verifiable conditions required for task completion."
    },
    "priority": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "status": {
      "type": "string",
      "enum": [
        "created",
        "classified",
        "planning",
        "awaiting_approval",
        "executing",
        "reviewing",
        "repairing",
        "succeeded",
        "failed",
        "cancelled",
        "needs_attention"
      ]
    },
    "risk_assessment": {
      "type": "object",
      "required": [
        "risk_level",
        "complexity",
        "uncertainty",
        "risk_basis",
        "routing_basis"
      ],
      "additionalProperties": false,
      "properties": {
        "risk_level": {
          "type": "string",
          "enum": [
            "read_only",
            "workspace_write",
            "system_sensitive",
            "danger_external"
          ],
          "description": "Determines execution authorization and approval gates."
        },
        "complexity": {
          "type": "string",
          "enum": ["low", "medium", "high", "expert"],
          "description": "Determines planning depth and decomposition."
        },
        "uncertainty": {
          "type": "string",
          "enum": ["low", "medium", "high", "exploratory"],
          "description": "Determines verification stringency and repair budget."
        },
        "risk_basis": {
          "type": "string",
          "minLength": 1,
          "description": "Concrete rationale for assigned risk level."
        },
        "routing_basis": {
          "type": "string",
          "minLength": 1,
          "description": "Rationale for assigned model, worker, and reviewer routing."
        }
      }
    },
    "budget": {
      "type": "object",
      "required": ["max_turns", "max_tokens", "max_execution_time_seconds"],
      "additionalProperties": false,
      "properties": {
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 100,
          "maximum": 5000000
        },
        "max_execution_time_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "max_cost_usd": {
          "type": "number",
          "minimum": 0.0
        }
      }
    },
    "context": {
      "type": "object",
      "required": ["workspace_root"],
      "additionalProperties": false,
      "properties": {
        "workspace_root": {
          "type": "string",
          "minLength": 1
        },
        "target_files": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "env_vars_whitelist": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "reference_docs": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "artifact_refs": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "tool_execution_evidence": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "review_verdict": {
      "type": ["string", "null"],
      "enum": ["pass", "revise", "reject", "needs_human", null],
      "default": null
    },
    "error_info": {
      "type": ["string", "null"],
      "default": null
    },
    "assigned_worker": {
      "type": ["string", "null"]
    },
    "assigned_reviewer": {
      "type": ["string", "null"]
    },
    "metadata": {
      "type": "object",
      "default": {}
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
