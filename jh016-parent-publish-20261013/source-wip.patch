+    def test_replace_entry_rename_blocked(self):
+        """B2-02 exact: a rename-away + recreate paused at the replace entry
+        must fail at the attacker's syscall (parent guard pins entries); the
+        legitimate publish then succeeds. Child evidence is structural:
+        return code plus stderr, never a bare nonzero exit."""
+        target = self.ws / "out" / "main.txt"
+        target.write_text("ORIGINAL", encoding="utf-8")
+        executor = FileToolExecutor(self.ws)
+        st = self._stage(executor, "task_b2rec01", "out/main.txt", "CANDIDATE")
+        probe = {}
+        real_replace = os.replace
+
+        def replace_boundary(src, dst):
+            if Path(dst) == target and not probe:
+                child_code = (
+                    "from pathlib import Path; import sys; p = Path(sys.argv[1]); "
+                    "p.rename(p.with_name('previous-object.json')); "
+                    "p.write_text('CONCURRENT_NEW', encoding='utf-8')")
+                child = subprocess.run(
+                    [sys.executable, "-X", "utf8", "-B", "-c", child_code, str(target)],
+                    capture_output=True, text=True, encoding="utf-8", timeout=30)
+                probe["rc"] = child.returncode
+                probe["stderr"] = (child.stderr or "").strip()
+                probe["target_before_publish"] = (
+                    target.read_text(encoding="utf-8") if target.exists() else None)
+            return real_replace(src, dst)
+
+        with patch("src.file_tools.os.replace", replace_boundary):
+            try:
+                outcome = executor.apply_staged(
+                    "task_b2rec01", target_path="out/main.txt", staged_path=st["staged_path"],
+                    content_sha256=st["content_sha256"], target_pre_sha256=st["target_pre_sha256"],
+                    authorized_files={"out/main.txt"})
+                applied_ok = outcome["applied"] and target.read_bytes() == b"CANDIDATE"
+            except PathBoundaryError:
+                applied_ok = False
+        self.assertIn("rc", probe)
+        self.assertNotEqual(probe["rc"], 0, "rename-away must fail loudly: " + probe["stderr"])
+        self.assertEqual(probe["target_before_publish"], "ORIGINAL")
