+def _make_junction(link: Path, target: Path) -> None:
+    proc = subprocess.run(["cmd", "/c", "mklink", "/J", str(link), str(target)],
+                          capture_output=True)
+    if proc.returncode != 0:
+        import _winapi
+        _winapi.CreateJunction(str(target), str(link))
+
