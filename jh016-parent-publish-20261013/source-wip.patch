+    def test_guarded_external_write_blocked(self):
+        """JH016-03: while the share-mode guard is held, an independent process
+        opening the target for write must fail; the guarded apply then succeeds
+        with the reviewed bytes."""
+        target = self.ws / "out" / "main.txt"
+        target.write_text("ORIGINAL", encoding="utf-8")
+        executor = FileToolExecutor(self.ws)
+        st = self._stage(executor, "task_jh016gd01", "out/main.txt", "CANDIDATE")
+        probe = {"ran": False, "rc": None, "stderr": ""}
+
+        def external_write_attempt(phase):
+            if phase != "guarded":
+                return
+            probe["ran"] = True
+            child_code = (
+                "import os, sys; fd = os.open(sys.argv[1], os.O_RDWR | getattr(os, 'O_BINARY', 0)); "
+                "os.lseek(fd, 1, os.SEEK_SET); os.write(fd, b'Z'); os.fsync(fd); os.close(fd)")
+            child = subprocess.run(
+                [sys.executable, "-X", "utf8", "-B", "-c", child_code, str(target)],
+                capture_output=True, text=True, encoding="utf-8", timeout=30)
+            probe["rc"] = child.returncode
+            probe["stderr"] = (child.stderr or "").strip()
+
+        executor.fault_injector = external_write_attempt
+        try:
+            outcome = executor.apply_staged(
+                "task_jh016gd01", target_path="out/main.txt", staged_path=st["staged_path"],
+                content_sha256=st["content_sha256"], target_pre_sha256=st["target_pre_sha256"],
+                authorized_files={"out/main.txt"})
+            applied_ok = outcome["applied"] and target.read_bytes() == b"CANDIDATE"
+        except PathBoundaryError:
+            applied_ok = False
+        self.assertTrue(probe["ran"])
+        self.assertNotEqual(probe["rc"], 0, "external write must fail loudly: " + probe["stderr"])
+        self.assertTrue(applied_ok)
